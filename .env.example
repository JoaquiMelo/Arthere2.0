# Arthere 2.0 — Expo / React Native
# Copie para .env na raiz do projeto mobile.
#
# Desenvolvimento/teste dentro da rede privada da nuvem:
# Este endereço só funciona para dispositivos que tenham rota até a rede privada
# onde está o Ubuntu. Em celular usando dados móveis ou outra rede, não funcionará.
EXPO_PUBLIC_API_URL=http://172.29.1.35:3006

# PRODUÇÃO (EAS Build / uso fora da rede privada):
# Depois de publicar a API com HTTPS, substitua a linha acima pelo endereço público,
# por exemplo: EXPO_PUBLIC_API_URL=https://api.seu-dominio.com
#
# Não coloque senhas, DATABASE_URL, JWT_SECRET ou qualquer segredo em EXPO_PUBLIC_*.
