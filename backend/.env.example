# Arthere 2.0 — Backend (NestJS + Prisma 7 + MySQL/MariaDB)
# Copie este arquivo para backend/.env e preencha os valores reais.
# Nunca versione backend/.env nem compartilhe credenciais.

PORT=3006

# Endereço PRIVADO do servidor MySQL/MariaDB (não é o IP do Ubuntu da API,
# a menos que o banco esteja instalado na mesma máquina).
# Codifique caracteres reservados da senha na URL (ex.: @ = %40, # = %23, % = %25).
DATABASE_URL="mysql://USUARIO_DO_BANCO:SENHA_URL_ENCODED@IP_PRIVADO_DO_MYSQL:3306/db_arthere"

# Gere um segredo aleatório forte e exclusivo para produção.
# Exemplo para gerar: openssl rand -base64 48
JWT_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE"

DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT=10000
DATABASE_ACQUIRE_TIMEOUT=10000
