# Arthere 2.0 — Backend (NestJS + Prisma 7 + MariaDB/MySQL)
# Copie este arquivo para backend/.env e substitua os placeholders.
# NUNCA versione backend/.env nem coloque credenciais reais no GitHub.

PORT=3006

# A senha deve estar codificada para URL (ex.: @ vira %40).
# Configure usuario e senha reais apenas no arquivo backend/.env do servidor.
DATABASE_URL="mysql://USUARIO:SENHA_URL_ENCODED@2.24.65.149:3306/db_arthere"

# Gere uma chave aleatória forte e exclusiva para cada ambiente.
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE"

# Ajustes opcionais do pool/conexão MariaDB
DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT=10000
DATABASE_ACQUIRE_TIMEOUT=10000
