DATABASE_URL=
JWT_SECRET=
PORT=3006

# Destino do seed. Use credenciais próprias com escopo restrito ao schema.
DEMO_SEED_DATABASE_URL=
DEMO_SEED_BATCH_ID=baixada
DEMO_SEED_RANDOM_SEED=20261128
# Vazia ou omitida: data civil de São Paulo no primeiro carregamento do lote.
# DEMO_SEED_ANCHOR=2026-11-28
DEMO_SEED_ALLOW_WRITE=false
DEMO_SEED_ALLOW_PRIMARY_DATABASE=false
DEMO_SEED_PASSWORD=
DEMO_SEED_ARTIFACT_DIR=
# Padrão: mysql para db_arthere, mariadb para schemas demonstrativos.
# DEMO_SEED_DUMP_CLIENT=mysql
# Se o cliente de dump não estiver no PATH, indique o executável.
# DEMO_SEED_DUMP_BIN=
# Opcional, para servidores que usam uma autoridade certificadora própria.
# DEMO_SEED_TLS_CA=
