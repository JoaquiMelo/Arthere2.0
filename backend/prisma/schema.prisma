generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id          String          @id @default(uuid())
  email       String          @unique
  senha       String
  tipo        TipoUsuario
  criadoEm    DateTime        @default(now())
  agente      AgenteCriativo?
  contratante Contratante?
  conversasComoA Conversa[] @relation("ConversaUsuarioA")
  conversasComoB Conversa[] @relation("ConversaUsuarioB")
  mensagens Mensagem[]

  @@map("usuario")
}

model AgenteCriativo {
  id              String        @id @default(uuid())
  usuarioId       String        @unique
  nome            String
  especialidade   String
  bio             String?       @db.Text
  estado          String        @default("")
  cidade          String        @default("")
  endereco        String        @default("")
  latitude        Float?
  longitude       Float?
  visivelMapa     Boolean       @default(false)
  avatarUrl       String?
  notaMedia       Float         @default(0)
  totalAvaliacoes Int           @default(0)
  totalProjetos   Int           @default(0)
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt
  usuario         Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  avaliacoes      Avaliacao[]
  candidaturas    Candidatura[]
  portfolio       Portfolio[]
  solicitacoesEvento SolicitacaoEvento[]

  @@index([cidade])
  @@index([especialidade])
  @@map("agente_criativo")
}

model Contratante {
  id           String      @id @default(uuid())
  usuarioId    String      @unique
  nome         String
  nomeSocial   String?
  pronomes     String?
  cpfCnpj      String?     @unique
  empresa      String?
  avatarUrl    String?
  telefone     String?
  descricao    String?     @db.Text
  site         String?
  estado       String?
  cidade       String?
  endereco     String?
  categoria    String?
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  avaliacoes   Avaliacao[]
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  projetos     Projeto[]
  eventos      Evento[]

  @@index([cidade])
  @@index([categoria])
  @@map("contratante")
}

model Projeto {
  id            String        @id @default(uuid())
  titulo        String
  descricao     String        @db.Text
  categoria     String
  status        StatusProjeto @default(ABERTO)
  orcamento     Float?
  dataEvento    DateTime?
  contratanteId String
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt
  candidaturas  Candidatura[]
  contratante   Contratante   @relation(fields: [contratanteId], references: [id], onDelete: Cascade)

  @@index([contratanteId])
  @@index([categoria])
  @@index([status])
  @@map("projeto")
}

model Candidatura {
  id           String            @id @default(uuid())
  status       StatusCandidatura @default(PENDENTE)
  mensagem     String?           @db.Text
  agenteId     String
  projetoId    String
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  agente       AgenteCriativo    @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  projeto      Projeto           @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([agenteId, projetoId])
  @@index([projetoId])
  @@index([status])
  @@map("candidatura")
}

model Portfolio {
  id        String         @id @default(uuid())
  imageUrl  String
  titulo    String?
  descricao String?        @db.Text
  agenteId  String
  criadoEm  DateTime       @default(now())
  agente    AgenteCriativo @relation(fields: [agenteId], references: [id], onDelete: Cascade)

  @@index([agenteId])
  @@map("portfolio")
}

model Avaliacao {
  id            String         @id @default(uuid())
  nota          Int
  comentario    String?        @db.Text
  agenteId      String
  contratanteId String
  criadoEm      DateTime       @default(now())
  agente        AgenteCriativo @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  contratante   Contratante    @relation(fields: [contratanteId], references: [id], onDelete: Cascade)

  @@unique([agenteId, contratanteId])
  @@index([agenteId])
  @@index([contratanteId])
  @@map("avaliacao")
}

model Evento {
  id            String       @id @default(uuid())
  titulo        String
  descricao     String       @db.Text
  categoria     String
  local         String
  cidade        String
  dataEvento    DateTime
  horario       String?
  organizador   String?
  premium       Boolean      @default(false)
  fixado        Boolean      @default(false)
  contratanteId String?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt
  contratante   Contratante? @relation(fields: [contratanteId], references: [id], onDelete: SetNull)
  solicitacoes  SolicitacaoEvento[]

  @@index([cidade])
  @@index([categoria])
  @@index([dataEvento])
  @@index([fixado, premium])
  @@map("evento")
}

model Conversa {
  id          String   @id @default(uuid())
  usuarioAId  String
  usuarioBId  String
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuarioA    Usuario  @relation("ConversaUsuarioA", fields: [usuarioAId], references: [id], onDelete: Cascade)
  usuarioB    Usuario  @relation("ConversaUsuarioB", fields: [usuarioBId], references: [id], onDelete: Cascade)
  mensagens   Mensagem[]

  @@unique([usuarioAId, usuarioBId])
  @@index([usuarioBId])
  @@map("conversa")
}

model Mensagem {
  id          String   @id @default(uuid())
  texto       String   @db.Text
  conversaId  String
  remetenteId String
  criadoEm    DateTime @default(now())
  conversa    Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  remetente   Usuario  @relation(fields: [remetenteId], references: [id], onDelete: Cascade)

  @@index([conversaId, criadoEm])
  @@index([remetenteId])
  @@map("mensagem")
}

model SolicitacaoEvento {
  id           String                  @id @default(uuid())
  status       StatusSolicitacaoEvento @default(PENDENTE)
  mensagem     String?                 @db.Text
  agenteId     String
  eventoId     String
  criadoEm     DateTime                @default(now())
  atualizadoEm DateTime                @updatedAt
  agente       AgenteCriativo          @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  evento       Evento                  @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([agenteId, eventoId])
  @@index([eventoId])
  @@index([status])
  @@map("solicitacao_evento")
}

enum TipoUsuario {
  AGENTE
  CONTRATANTE
  ADMIN
}

enum StatusProjeto {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum StatusCandidatura {
  PENDENTE
  ACEITA
  RECUSADA
}

enum StatusSolicitacaoEvento {
  PENDENTE
  ACEITA
  RECUSADA
}
