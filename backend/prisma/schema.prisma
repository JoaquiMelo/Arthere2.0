generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id          String          @id @default(uuid())
  email       String          @unique
  senha       String
  tipo        TipoUsuario
  criadoEm    DateTime        @default(now())
  agente      AgenteCriativo?
  contratante Contratante?

  @@map("usuario")
}

model AgenteCriativo {
  id              String        @id @default(uuid())
  usuarioId       String        @unique
  nome            String
  especialidade   String
  bio             String?       @db.Text
  cidade          String        @default("")
  endereco        String        @default("")
  latitude        Float?
  longitude       Float?
  visivelMapa     Boolean       @default(false)
  avatarUrl       String?
  notaMedia       Float         @default(0)
  totalAvaliacoes Int           @default(0)
  totalProjetos   Int           @default(0)
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt
  usuario         Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  avaliacoes      Avaliacao[]
  candidaturas    Candidatura[]
  portfolio       Portfolio[]

  @@map("agente_criativo")
}

model Contratante {
  id           String      @id @default(uuid())
  usuarioId    String      @unique
  nome         String
  empresa      String?
  avatarUrl    String?
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  avaliacoes   Avaliacao[]
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  projetos     Projeto[]

  @@map("contratante")
}

model Projeto {
  id            String        @id @default(uuid())
  titulo        String
  descricao     String        @db.Text
  categoria     String
  status        StatusProjeto @default(ABERTO)
  orcamento     Float?
  dataEvento    DateTime?
  contratanteId String
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt
  candidaturas  Candidatura[]
  contratante   Contratante   @relation(fields: [contratanteId], references: [id], onDelete: Cascade)

  @@index([contratanteId], map: "projeto_contratanteId_fkey")
  @@map("projeto")
}

model Candidatura {
  id           String            @id @default(uuid())
  status       StatusCandidatura @default(PENDENTE)
  mensagem     String?           @db.Text
  agenteId     String
  projetoId    String
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  agente       AgenteCriativo    @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  projeto      Projeto           @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([agenteId, projetoId])
  @@index([projetoId], map: "candidatura_projetoId_fkey")
  @@map("candidatura")
}

model Portfolio {
  id        String         @id @default(uuid())
  imageUrl  String
  titulo    String?
  descricao String?
  agenteId  String
  criadoEm  DateTime       @default(now())
  agente    AgenteCriativo @relation(fields: [agenteId], references: [id], onDelete: Cascade)

  @@index([agenteId], map: "portfolio_agenteId_fkey")
  @@map("portfolio")
}

model Avaliacao {
  id            String         @id @default(uuid())
  nota          Int
  comentario    String?        @db.Text
  agenteId      String
  contratanteId String
  criadoEm      DateTime       @default(now())
  agente        AgenteCriativo @relation(fields: [agenteId], references: [id], onDelete: Cascade)
  contratante   Contratante    @relation(fields: [contratanteId], references: [id], onDelete: Cascade)

  @@index([agenteId], map: "avaliacao_agenteId_fkey")
  @@index([contratanteId], map: "avaliacao_contratanteId_fkey")
  @@map("avaliacao")
}

enum TipoUsuario {
  AGENTE
  CONTRATANTE
  ADMIN
}

enum StatusProjeto {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum StatusCandidatura {
  PENDENTE
  ACEITA
  RECUSADA
}
